# 디스코드 봇 토큰 (https://discord.com/developers/applications → Bot → Token)
TOKEN_BOT=

# 봇을 쓸 디스코드 서버(길드) ID
TOKEN_SERVER=

# (선택) 디버그용 길드 ID
TOKEN_SERVER_DEBUG=

# (선택) 자동 알림(서버 다운/복구, 접속/퇴장) 채널 ID. 비우면 알림 비활성.
CHANNEL_NOTICE=

# 팰월드 REST API — 비밀번호는 ~/palworld/.env 의 PAL_ADMIN_PASSWORD 와 동일하게.
PAL_API_URL=http://palworld:8212
PAL_API_USER=admin
PAL_API_PASSWORD=

# 팰월드 컨테이너 이름 / 안내용 접속 주소
PAL_CONTAINER=palworld
PAL_ADDRESS=pal.moon-core.com:8211
